# remote_sl_9 = 109  # 设备序列号

# 配置说明：
# 1. local_port为0时，表示不启用本地监听，仅作为客户端主动连接远程节点
# 2. 可以配置多个远程节点，索引从0开始，连续递增
# 3. 每个远程节点需要配置ip、port、cid和sl四个参数
# 4. remote_sl为设备序列号，用于标识不同的设备
# 5. 日志文件路径留空则输出到控制台
# 6. 配置文件支持注释，以#开头的行将被忽略
