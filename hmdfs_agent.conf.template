# HMDFS Agent Configuration File
# This is a template configuration file for hmdfs_agent
# Copy this file to a new location and edit it according to your needs

# 本地配置选项
# 本地监听端口，0表示不启用本地监听
local_port = 12345

# 本机IP地址
local_ip = 127.0.0.1

# 本地CID（设备标识）
local_cid = HMDFS-local-12345

# 日志文件路径（可选，留空则输出到控制台）
log_file =

# 远程节点配置示例
# 节点1配置
remote_ip_0 = 192.168.1.100
remote_port_0 = 12345
remote_cid_0 = HMDFS-remote-100
remote_sl_0 = 100  # 设备序列号

# 节点2配置（可选）
# remote_ip_1 = 192.168.1.101
# remote_port_1 = 12345
# remote_cid_1 = HMDFS-remote-101
# remote_sl_1 = 101  # 设备序列号

# 节点3配置（可选）
# remote_ip_2 = 192.168.1.102
# remote_port_2 = 12345
# remote_cid_2 = HMDFS-remote-102
# remote_sl_2 = 102  # 设备序列号

# 节点4配置（可选）
# remote_ip_3 = 192.168.1.103
# remote_port_3 = 12345
# remote_cid_3 = HMDFS-remote-103
# remote_sl_3 = 103  # 设备序列号

